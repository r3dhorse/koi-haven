# Admin
# Default password is "changeme" — change it from the admin Settings page after first login.

# Google Drive service account (used for koi media uploads)
# 1. Create a Google Cloud project.
# 2. Enable the "Google Drive API".
# 3. Create a Service Account, then create a JSON key for it.
# 4. Copy the values from that JSON into the variables below.
# 5. Create a Drive folder, share it with the service account email,
#    then put the folder ID below (the long string in the folder URL).

GOOGLE_DRIVE_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...replace...with...the...newline-escaped...key...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
